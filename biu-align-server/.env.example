# Biu 歌词时间轴对齐服务配置模板，复制为 .env 填真实值（.env 已被 gitignore）

# 只监听 127.0.0.1，前面挂反代
PORT=3003

# 必须和 biu-sync-server 的 JWT_SECRET 相同：客户端用那边换来的 token 调这里
JWT_SECRET=change-me-same-as-biu-sync-server

# 对齐结果缓存、提交与审核记录：{DATA_DIR}/alignments、submissions、approved
DATA_DIR=/data/biu-align

# 每个任务的临时目录（下载的音频、分离出的人声），任务结束即删
WORK_DIR=

# 装好 torch / torchaudio / demucs / pypinyin / soundfile / scipy 的 Python（见 README「Python 环境」）
PYTHON_BIN=python3

# 审核员 B 站 UID，逗号分隔（space.bilibili.com/<UID> 里的数字）
ADMIN_MIDS=

# 留空 = 允许所有来源；Electron 客户端不受 CORS 限制
CORS_ORIGIN=

# 单任务超时、最长投稿时长（不设排队上限和每日次数，见 src/lib/queue.ts 顶部说明）
JOB_TIMEOUT_MS=600000
MAX_DURATION_SEC=600

# 每 mid 每分钟请求数（客户端每 3 s 轮询一次约 20 次/分）
RATE_LIMIT_PER_MINUTE=300

# B 站接口相邻请求最小间隔（毫秒），调小容易触发 -352 风控
BILIBILI_MIN_INTERVAL_MS=3000

# 本地开发：mock = 不访问 B 站、不跑 Python，给出假对齐结果（也可用 pnpm dev:mock）。生产环境下拒绝启动
ALIGN_WORKER=
# mock 模式下假装对齐要花的时间（毫秒），方便看轮询 / 排队界面
MOCK_DELAY_MS=3000
