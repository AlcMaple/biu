# 推荐：chmod 600 /受控路径/production.env

BIU_PUBLIC_ORIGIN=https://music.example.com
BIU_CLOUD_SSH_ALIAS=biu-production
BIU_CLOUD_ARTIFACT_DIR=/private/artifact-directory

# Update publisher: use a dedicated SFTP-only account, never root.
BIU_UPDATE_PUBLIC_ORIGIN=https://updates.example.com/updates/
BIU_UPDATE_PUBLISH_HOST=private-update-hostname
BIU_UPDATE_PUBLISH_USER=biu-update-publisher
BIU_UPDATE_REMOTE_DIR=/updates/
BIU_UPDATE_PUBLISH_KEY=/private/ssh-key
# Alternatively leave BIU_UPDATE_PUBLISH_KEY unset and use SSH_AUTH_SOCK.
# Private Ed25519 signing key for the free personal Windows update channel.
# Its matching public key is embedded in the app; never upload this file or commit it.
BIU_UPDATE_SIGNING_KEY=/private/update-signing-ed25519.pem

BIU_WEB_RELEASE_ROOT=/private/web-release-root
BIU_WEB_AGENT_FILE=/private/web-agent.plist
BIU_WEB_SERVICE_LABEL=com.example.biu.web
BIU_WEB_NODE=/private/node
BIU_WEB_PORT=5678
BIU_WEB_TEST_PORT=15679
BIU_HEALTH_PATH=/__biu_health

BIU_SYNC_INTERNAL_ORIGIN=http://127.0.0.1:3002
BIU_SYNC_DATA_DIR=/private/sync-data-directory
BIU_SYNC_BACKUP_ROOT=/private/sync-backup-root
BIU_SYNC_LOG_FILE=/private/sync-log-file
BIU_TEST_ACCOUNT_ID=replace-with-non-production-test-account-id
BIU_ACME_CHALLENGE_ORIGIN=http://127.0.0.1:18095
BIU_ACME_SERVICE_LABEL=com.example.biu.acme.renew
BIU_CERTBOT_BIN=/private/certbot
BIU_CERTBOT_CONFIG_DIR=/private/certbot-config
BIU_CERTBOT_WORK_DIR=/private/certbot-work
BIU_CERTBOT_LOG_DIR=/private/certbot-logs
