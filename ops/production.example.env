# 这是部署/维护参数模板，不是应用运行时的 .env 文件。
# 真实值必须按当前机器重新填写，不能直接照抄本示例；真实文件应放在仓库外。
# 本项目受控终端的默认真实配置路径：~/.config/biu/production.env
# 首次创建后执行：chmod 600 ~/.config/biu/production.env
# 再加载：export BIU_OPS_CONFIG="$HOME/.config/biu/production.env"
#
# 普通 Web 更新（构建 dist/web + dist/server、切换 Web 服务）主要使用：
#   公网与制品中转：BIU_PUBLIC_ORIGIN、BIU_CLOUD_SSH_ALIAS、BIU_CLOUD_ARTIFACT_DIR
#   Mac mini Web：BIU_WEB_* 全部字段
#   Web 到本机同步服务的桥接：BIU_SYNC_INTERNAL_ORIGIN
#
# 只有特定维护任务才需要下面两组：
#   自动更新发布：BIU_UPDATE_*（见 docs/release/自动更新部署指南.md）
#   sync 数据迁移/备份：BIU_SYNC_DATA_DIR、BIU_SYNC_BACKUP_ROOT、BIU_SYNC_LOG_FILE
#   证书续期：BIU_ACME_*、BIU_CERTBOT_*
# 普通 Web 更新不会修改 sync 数据目录，也不需要上传签名私钥。

# ---- 公网入口与制品中转：普通 Web 发布需要 ----
# 对外访问的完整 HTTPS origin；必须与反代保留的 Host 完全一致。
BIU_PUBLIC_ORIGIN=https://music.example.com
# ~/.ssh/config 中的受控 SSH 别名；不要在公开文档写 IP、root 或密钥路径。
BIU_CLOUD_SSH_ALIAS=biu-production
# 云主机上仅用于暂存发布包的目录；不要指向网站根目录或数据目录。
BIU_CLOUD_ARTIFACT_DIR=/private/artifact-directory

# ---- Windows 自动更新发布：仅发布桌面更新时需要，普通 Web 更新不用 ----
# 使用最小权限的 SFTP 账号，禁止使用 root。
BIU_UPDATE_PUBLIC_ORIGIN=https://updates.example.com/updates/
BIU_UPDATE_PUBLISH_HOST=private-update-hostname
BIU_UPDATE_PUBLISH_USER=biu-update-publisher
BIU_UPDATE_REMOTE_DIR=/updates/
BIU_UPDATE_PUBLISH_KEY=/private/ssh-key
# 如果改用 SSH_AUTH_SOCK，请删除这一行或将值留空。
# Windows 免费个人更新通道的 Ed25519 私钥；只用于本地签名，绝不能上传或提交。
BIU_UPDATE_SIGNING_KEY=/private/update-signing-ed25519.pem

# ---- Mac mini Web 服务：普通 Web 发布需要 ----
# 发布根目录；每次发布在这里新建一个时间戳子目录，不能覆盖旧 release。
BIU_WEB_RELEASE_ROOT=/private/web-release-root
# Web LaunchAgent plist；只更新 release 路径和日志路径，其他环境变量保持原值。
BIU_WEB_AGENT_FILE=/private/web-agent.plist
# plist 中的 Label，必须与该服务实际标签一致，避免 bootout 错服务。
BIU_WEB_SERVICE_LABEL=com.example.biu.web
# Mac mini 上实际运行的 Node（应固定到已验证的版本/架构）。
BIU_WEB_NODE=/private/node
# 线上 Web 监听端口；测试端口必须是同机未占用的另一端口。
BIU_WEB_PORT=5678
BIU_WEB_TEST_PORT=15679
# Biu Web 健康检查路径；由 web-server 固定提供。
BIU_HEALTH_PATH=/__biu_health

# ---- sync 桥接与数据：桥接是 Web 运行时需要，数据字段仅高风险维护需要 ----
# Web BFF 访问本机 sync 服务的内部 origin；HTTP 只允许 loopback。
BIU_SYNC_INTERNAL_ORIGIN=http://127.0.0.1:3002
# 以下三项用于第 6 节的 sync 数据备份/迁移/恢复；普通 Web 更新不要改动它们。
BIU_SYNC_DATA_DIR=/private/sync-data-directory
BIU_SYNC_BACKUP_ROOT=/private/sync-backup-root
BIU_SYNC_LOG_FILE=/private/sync-log-file
# 仅用于跨端同步验收的非生产测试账号，不要填真实用户账号。
BIU_TEST_ACCOUNT_ID=replace-with-non-production-test-account-id

# ---- ACME/证书：仅当前域名采用 HTTP-01 挑战回落时需要 ----
# 固定的本机 challenge origin，不能填任意 URL，也不能改成通用代理。
BIU_ACME_CHALLENGE_ORIGIN=http://127.0.0.1:18095
# 负责续期的 LaunchAgent 标签。
BIU_ACME_SERVICE_LABEL=com.example.biu.acme.renew
# Certbot 及其配置、工作、日志目录；以该环境实际安装位置为准。
BIU_CERTBOT_BIN=/private/certbot
BIU_CERTBOT_CONFIG_DIR=/private/certbot-config
BIU_CERTBOT_WORK_DIR=/private/certbot-work
BIU_CERTBOT_LOG_DIR=/private/certbot-logs
