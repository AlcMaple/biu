# SFTP 服务器地址，比如：阿里云 ECS 的公网 IP 203.0.113.10（不要填 https://）
BIU_UPDATE_PUBLISH_HOST=

# 服务器上专门用来上传安装包的用户名，比如：biu-update-publisher
# 按 docs/release/服务器首次配置.md 创建，不是阿里云登录账号，也不是 root
BIU_UPDATE_PUBLISH_USER=biu-update-publisher

# 安装包传到哪里：按服务器教程配置后，这里填 /updates/
BIU_UPDATE_REMOTE_DIR=/updates/

# 用户下载更新的地址，比如：https://updates.example.com/updates/
# 换成你自己的域名，末尾保留 /；需要先完成服务器 HTTPS 配置
BIU_UPDATE_PUBLIC_ORIGIN=

# 本机的 SSH 私钥文件路径，用 ssh-keygen 生成；不要填 .pub 公钥文件
# Windows 比如：C:/Users/zhangsan/.config/biu/keys/biu_update_publisher
# Mac 比如：/Users/zhangsan/.config/biu/keys/biu_update_publisher
BIU_UPDATE_PUBLISH_KEY=

# 仅发布 Windows 时填写：本机的更新签名私钥文件路径
# 新 fork 首次运行 node dev_tools/generate-update-signing-key.js 生成自己的密钥
# 默认生成在用户目录的 .config/biu/update-signing-ed25519.pem
# Windows 比如：C:/Users/zhangsan/.config/biu/update-signing-ed25519.pem
# 后续发版继续使用同一把，不能每次重新生成；只发布 Mac 则留空
BIU_UPDATE_SIGNING_KEY=
