# Biu 本地歌单云同步服务配置模板
# 复制为 .env 并填入真实值（.env 已被 gitignore 屏蔽）

# 服务监听端口（只监听 127.0.0.1，前面挂 Apache 反代，不直接暴露公网）
PORT=3002

# JWT 签名密钥 —— 一串随机字符串即可，例如：openssl rand -hex 32
# 泄露风险等同于能伪造任意用户身份，务必只放在服务器 .env，不进 git
JWT_SECRET=change-me-to-a-random-secret

# JWT 有效期（秒），过期后客户端用 B 站 cookie 静默重新换发，不需要用户感知
JWT_TTL_SECONDS=7200

# 数据存储根目录：{DATA_DIR}/{mid}/{store}.json
# 确保这个目录所在分区有独立的磁盘配额监控，服务本身不做磁盘用量上限
DATA_DIR=/data/biu-sync

# 允许的客户端来源（CORS），Electron 客户端一般不受 CORS 限制（非浏览器环境）
# 留空 = 允许所有来源
CORS_ORIGIN=

# 每 mid 每分钟允许的同步请求数，超过则 429（防止异常客户端打满这台内存紧张的机器）
RATE_LIMIT_PER_MINUTE=60

# 墓碑（已删除条目标记）保留天数，超过这个天数的墓碑会被每日清理任务物理移除
TOMBSTONE_RETENTION_DAYS=30
